# ==========================================
# NatureQuest AI — Environment Configuration
# ==========================================

# Application & API
PROJECT_NAME="NatureQuest AI"
API_V1_STR="/api/v1"

# Security (Set a long random string for production)
SECRET_KEY="production-secret-naturequest-ai-2026-hacktoberfest-secure"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES="10080"

# Database (SQLite by default for zero-config; or Postgres on production)
# DATABASE_URL="postgresql://user:password@host:5432/naturequest"
DATABASE_URL="sqlite:///./naturequest.db"

# Media Storage
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB="15"

# NeuralEye AI Forensics
NEURALEYE_PROVIDER="haywoodsloan_swinv2"

# Ollama Open-Weight LLM (Optional on cloud if running local Ollama)
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:1.5b"
